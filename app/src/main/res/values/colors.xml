<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Dark backdrop for the adaptive icon.

      The artwork itself is a white square with dark content, so a white
      background made the whole icon read as one blank white field. A near-black
      backdrop separates the artwork from the frame and matches the app's
      monochrome palette.
    -->
    <color name="ic_launcher_background">#0A0A0A</color>
</resources>